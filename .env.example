# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/feedback_db
# Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/feedback_db
MONGO_URI=mongodb://localhost:27017/feedback_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long, random string. Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max login/register attempts per 15 minutes per IP
RATE_LIMIT_MAX=10
